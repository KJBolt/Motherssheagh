<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="about" name="About">
        <t t-call="website.layout">
            <t t-set="title">About</t>
            <t t-set="head">
                <link rel="preconnect" href="https://fonts.googleapis.com"/>
                <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""/>
                <link href="https://fonts.googleapis.com/css2?family=Droid+Sans:wght@400;700&amp;display=swap" rel="stylesheet"/>
                <style>
                    body, h1, h2, h3, h4, h5, h6, p, a, button, .btn {
                        font-family: 'Droid Sans', sans-serif !important;
                    }
                    <!-- .fa-shopping-cart{
                        display: none;
                    }

                    .o_wsale_my_cart{
                        display: none;
                    } -->
                </style>
            </t>
            <div id="wrap" class="oe_structure oe_empty">

                <!-- First Section -->
                <section style="padding: 50px 0 80px 0; background-color: #ffffff;">
                    <div class="container">
                        <div class="row align-items-center">
                            <!-- Left Column - Text Content -->
                            <div class="col-lg-6 mb-4 mb-lg-0">
                                <h6 class="display-6 fw-bold mb-4">From Ancient Wisdom to Modern Beauty</h6>
                                
                                <p class="text-muted mb-4" style="font-size: 1rem; line-height: 1.8;">
                                    Our story begins with shea butter and shea oil, timeless treasures passed down through generations of African women who understood the power of nature’s touch. 
                                    We carry that legacy forward, blending pure shea with other natural oils to create rich, nurturing products for skin and hair.
                                </p>
                                
                                <!-- Mission Box -->
                                <div class="d-flex align-items-start p-3" style="background-color: #fef8f0; border-radius: 10px; max-width: 450px;">
                                    <div class="d-flex align-items-center justify-content-center rounded-circle me-3" style="width: 50px; height: 50px; background-color: #fef3e8; flex-shrink: 0;">
                                        <i class="fa fa-heart-o" style="font-size: 24px; color: #e9964e;"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold mb-1">Our Mission</h6>
                                        <p class="text-muted mb-0" style="font-size: 0.9rem;">
                                            Empowering communities while delivering pure, natural beauty
                                        </p>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Right Column - Image -->
                            <div class="col-lg-6">
                                <div class="position-relative">
                                    <img src="/sheaonyou/static/src/img/beauty.jpg" class="img-fluid rounded" alt="African Woman with Shea Nuts" style="border-radius: 15px; width: 100%; height: 400px; object-fit: cover;"/>
                                    
                                    <!-- Year Badge -->
                                    <div class="position-absolute" style="bottom: 20px; left: 20px; background-color: #e9964e; padding: 20px 30px; border-radius: 10px;">
                                        <h3 class="text-white fw-bold mb-0" style="font-size: 2rem;">2009</h3>
                                        <p class="text-white mb-0" style="font-size: 0.9rem;">Founded with Purpose</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>


                <!-- Second Section -->
                <section style="padding: 80px 0; background-color: #f8f9fa;">
                    <div class="container">
                        <!-- Section Header -->
                        <div class="text-center mb-5">
                            <h6 class="display-6 fw-bold mb-3">Our Core Values</h6>
                            <p class="text-muted" style="max-width: 700px; margin: 0 auto;">
                                These principles guide everything we do, from sourcing to delivery, ensuring that every product reflects our commitment to excellence and ethics.
                            </p>
                        </div>
                        
                        <!-- Values Grid -->
                        <div class="row g-4">
                            <!-- Value 1: Sustainability -->
                            <div class="col-lg-4 col-md-6">
                                <div class="card h-100 border-0 shadow-sm" style="border-radius: 15px; background-color: white;">
                                    <div class="card-body p-4">
                                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 60px; height: 60px; background-color: #fef3e8;">
                                            <i class="fa fa-leaf" style="font-size: 24px; color: #e9964e;"></i>
                                        </div>
                                        <h5 class="fw-semibold mb-3">Sustainability</h5>
                                        <p class="text-muted mb-0" style="font-size: 0.95rem;">
                                            We protect the environment through responsible sourcing and eco-friendly packaging, ensuring future generations can enjoy nature's gifts.
                                        </p>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Value 2: Fair Trade -->
                            <div class="col-lg-4 col-md-6">
                                <div class="card h-100 border-0 shadow-sm" style="border-radius: 15px; background-color: white;">
                                    <div class="card-body p-4">
                                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 60px; height: 60px; background-color: #fef3e8;">
                                            <i class="fa fa-handshake-o" style="font-size: 24px; color: #e9964e;"></i>
                                        </div>
                                        <h5 class="fw-semibold mb-3">Fair Trade</h5>
                                        <p class="text-muted mb-0" style="font-size: 0.95rem;">
                                            Every purchase directly supports African women and their families, providing fair wages and sustainable livelihoods in rural communities.
                                        </p>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Value 3: Purity -->
                            <div class="col-lg-4 col-md-6">
                                <div class="card h-100 border-0 shadow-sm" style="border-radius: 15px; background-color: white;">
                                    <div class="card-body p-4">
                                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 60px; height: 60px; background-color: #fef3e8;">
                                            <i class="fa fa-shield" style="font-size: 24px; color: #e9964e;"></i>
                                        </div>
                                        <h5 class="fw-semibold mb-3">Purity</h5>
                                        <p class="text-muted mb-0" style="font-size: 0.95rem;">
                                            Our products contain no chemicals, additives, or artificial ingredients - just pure, unrefined shea butter as nature intended.
                                        </p>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Value 4: Community -->
                            <div class="col-lg-4 col-md-6">
                                <div class="card h-100 border-0 shadow-sm" style="border-radius: 15px; background-color: white;">
                                    <div class="card-body p-4">
                                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 60px; height: 60px; background-color: #fef3e8;">
                                            <i class="fa fa-users" style="font-size: 24px; color: #e9964e;"></i>
                                        </div>
                                        <h5 class="fw-semibold mb-3">Community</h5>
                                        <p class="text-muted mb-0" style="font-size: 0.95rem;">
                                            We build lasting partnerships with local communities, investing in education, healthcare, and infrastructure development.
                                        </p>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Value 5: Quality -->
                            <div class="col-lg-4 col-md-6">
                                <div class="card h-100 border-0 shadow-sm" style="border-radius: 15px; background-color: white;">
                                    <div class="card-body p-4">
                                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 60px; height: 60px; background-color: #fef3e8;">
                                            <i class="fa fa-lightbulb-o" style="font-size: 24px; color: #e9964e;"></i>
                                        </div>
                                        <h5 class="fw-semibold mb-3">Quality</h5>
                                        <p class="text-muted mb-0" style="font-size: 0.95rem;">
                                            Each batch is carefully tested and meets the highest standards for purity, potency, and effectiveness in skincare.
                                        </p>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Value 6: Transparency -->
                            <div class="col-lg-4 col-md-6">
                                <div class="card h-100 border-0 shadow-sm" style="border-radius: 15px; background-color: white;">
                                    <div class="card-body p-4">
                                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 60px; height: 60px; background-color: #fef3e8;">
                                            <i class="fa fa-globe" style="font-size: 24px; color: #e9964e;"></i>
                                        </div>
                                        <h5 class="fw-semibold mb-3">Transparency</h5>
                                        <p class="text-muted mb-0" style="font-size: 0.95rem;">
                                            We believe in complete transparency about our sourcing, production methods, and the impact of every purchase you make.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                


                <!-- Third Section - Meet Our Team -->
                <section style="padding: 80px 0; background-color: #ffffff;">
                    <div class="container">
                        <!-- Section Header -->
                        <div class="text-center mb-5">
                            <h6 class="display-6 fw-bold mb-3">Meet Our Team</h6>
                            <p class="text-muted" style="max-width: 700px; margin: 0 auto;">
                                Our passionate team combines expertise in beauty, sustainability, and community development to bring you the finest shea butter products.
                            </p>
                        </div>
                        
                        <!-- Team Grid -->
                        <div class="row g-4">
                            <!-- Team Member 1: Sarah Mitchell -->
                            <div class="col-lg-6 col-md-6">
                                <div class="card h-100 border-0 shadow-sm" style="border-radius: 15px; overflow: hidden;">
                                    <img src="/sheaonyou/static/src/img/woman_ceo.png" class="card-img-top" alt="Sarah Mitchell" style="height: 280px; object-fit: cover;"/>
                                    <div class="card-body text-center p-4">
                                        <h5 class="fw-semibold mb-1">Sarah Mitchell</h5>
                                        <p class="mb-3" style="color: #e9964e; font-size: 0.9rem; font-weight: 500;">Co Founder &amp; Social Media Handler</p>
                                        <p class="text-muted" style="font-size: 0.85rem; line-height: 1.6;">
                                            Founder and chief visionary, Emily is the driving force behind the company. She loves to keep her hands full by participating in the development of the cosmetics, marketing, and customer experience strategies.
                                        </p>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Team Member 2: Dr. Amara Osei -->
                            <div class="col-lg-6 col-md-6">
                                <div class="card h-100 border-0 shadow-sm" style="border-radius: 15px; overflow: hidden;">
                                    <img src="/sheaonyou/static/src/img/man_ceo.png" class="card-img-top" alt="Dr. Amara Osei" style="height: 280px; object-fit: cover;"/>
                                    <div class="card-body text-center p-4">
                                        <h5 class="fw-semibold mb-1">Dr. Amara Osei</h5>
                                        <p class="mb-3" style="color: #e9964e; font-size: 0.9rem; font-weight: 500;">Founder &amp; CEO</p>
                                        <p class="text-muted" style="font-size: 0.85rem; line-height: 1.6;">
                                            A visionary skincare brand dedicated to delivering high-quality, science-backed, and nature-inspired beauty solutions. With a passion for skin wellness and an entrepreneurial spirit, Sirleonel established the company with the mission to empower individuals to feel confident and radiant in their natural skin.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                
            </div>
        </t>
    </template>
</odoo>